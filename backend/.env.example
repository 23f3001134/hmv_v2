# Copy this file to backend/.env for local development. NEVER commit .env.
# Generate each secret with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too

# Used by:  flask --app app seed-admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-strong-password

# Frontend URL(s) allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:5173

# Optional
# DATABASE_URL=sqlite:///hospital.db
# JWT_ACCESS_TOKEN_EXPIRES_MINUTES=120
# CACHE_TYPE=RedisCache
# CACHE_REDIS_URL=redis://localhost:6379/1
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0
# SMTP_HOST=
# SMTP_USERNAME=
# SMTP_PASSWORD=
# DEFAULT_GCHAT_WEBHOOK_URL=
